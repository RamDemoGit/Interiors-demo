# ---- Site ----
# Canonical origin, no trailing slash. Used for metadataBase, sitemap, JSON-LD, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Analytics (loaded only after cookie consent) ----
NEXT_PUBLIC_GA_ID=

# ---- Email (enquiry notifications + confirmation) ----
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "Lahima In-Des <enquiries@your-domain>"
EMAIL_FROM=
# Internal inbox that receives new enquiries.
ENQUIRY_TO=lahimaindes@gmail.com

# Optional SMTP fallback (nodemailer) when RESEND_API_KEY is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Spam protection ----
# Set to "true" to enable Cloudflare Turnstile on the enquiry form.
NEXT_PUBLIC_ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional Upstash Redis for a durable rate limit (in-memory is the default)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Lead storage ----
# "file" (default, ./.data/leads.jsonl) | later: "sqlite" | "supabase"
LEAD_STORE=file

# ---- Build guard ----
# Set to "true" ONLY if you knowingly want to deploy placeholder project images.
ALLOW_PLACEHOLDER_IMAGES=false
