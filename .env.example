# ---- Site ----
# Canonical origin, no trailing slash. Used for metadataBase, sitemap, JSON-LD, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Analytics (optional; loaded only after cookie consent) ----
NEXT_PUBLIC_GA_ID=

# ---- Build guard ----
# Set to "true" ONLY if you knowingly want to deploy placeholder project images.
ALLOW_PLACEHOLDER_IMAGES=false

# No email service is needed. The enquiry form opens the visitor's own email app
# (or WhatsApp, once a WhatsApp number is set in src/config/site.ts).
